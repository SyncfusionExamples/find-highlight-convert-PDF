<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Syncfusion_MauiWordtoPDFSample.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:Syncfusion_MauiWordtoPDFSample.Pages"
    Title="Word to PDF">

    <ShellContent
        Title="Word to PDF"
        ContentTemplate="{DataTemplate pages:WordToPdfPage}"
        Route="wordtopdf" />

    <ShellContent
        Title="PDF Viewer"
        ContentTemplate="{DataTemplate pages:PdfViewerPage}"
        Route="pdfviewer" />

</Shell>
